      <div>
        <h4>便利なサービス</h4>
        <ul>
          <li>店舗・ATM検索</li>
          <li>来店予約</li>
          <li>スマホアプリ</li>
          <li>オルPay</li>
        </ul>
      </div>
      <div>
        <h4>サポート</h4>
        <ul>
          <li>各種お手続き</li>
          <li>よくある質問</li>
          <li>お問い合わせ</li>
          <li>サイトマップ</li>
        </ul>
      </div>
    </div>
    <p class="copy">© Holy Ormezian Empire Central Bank. This is a fictional website sample.</p>
  </footer>
</body>
